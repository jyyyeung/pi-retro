{
  "name": "pi-retro",
  "version": "0.1.1",
  "description": "Retrospective loop for your pi coding-agent setup: cost-filtered friction ledger, trials verdicts, weekly adopt/evaluate/reject review.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "retrospective",
    "friction",
    "agent",
    "improvement",
    "coding-agent"
  ],
  "pi": {
    "extensions": ["./extensions/retro.ts"],
    "skills": ["./skills/friction-log", "./skills/weekly-review"],
    "prompts": ["./prompts/retro.md"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.6"
  }
}
